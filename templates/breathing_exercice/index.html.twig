{% extends 'base.html.twig' %}

{% block title %}BreathingExercice index{% endblock %}

{% block body %}
    <h1>BreathingExercice index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Duration</th>
                <th>Description</th>
                <th>Type</th>
                <th>TimeInhale</th>
                <th>TimeHold</th>
                <th>TimeExhale</th>
                <th>NumberCycle</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for breathing_exercice in breathing_exercices %}
            <tr>
                <td>{{ breathing_exercice.id }}</td>
                <td>{{ breathing_exercice.name }}</td>
                <td>{{ breathing_exercice.duration }}</td>
                <td>{{ breathing_exercice.description }}</td>
                <td>{{ breathing_exercice.type }}</td>
                <td>{{ breathing_exercice.timeInhale }}</td>
                <td>{{ breathing_exercice.timeHold }}</td>
                <td>{{ breathing_exercice.timeExhale }}</td>
                <td>{{ breathing_exercice.numberCycle }}</td>
                <td>{{ breathing_exercice.createdAt }}</td>
                <td>
                    <a href="{{ path('app_breathing_exercice_show', {'id': breathing_exercice.id}) }}">show</a>
                    <a href="{{ path('app_breathing_exercice_edit', {'id': breathing_exercice.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_breathing_exercice_new') }}">Create new</a>
{% endblock %}

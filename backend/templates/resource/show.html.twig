{% extends 'base.html.twig' %}

{% block title %}Resource{% endblock %}

{% block body %}
    <h1>Resource</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ resource.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ resource.title }}</td>
            </tr>
            <tr>
                <th>Text</th>
                <td>{{ resource.text }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ resource.image }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ resource.type }}</td>
            </tr>
            <tr>
                <th>Visible</th>
                <td>{{ resource.visible ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ resource.createdAt }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ resource.updatedAt }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_resource_index') }}">back to list</a>

    <a href="{{ path('app_resource_edit', {'id': resource.id}) }}">edit</a>

    {{ include('resource/_delete_form.html.twig') }}
{% endblock %}
